    category: str
    description: str
    location_found: str
    date_found: str
    storage_location: str
    status: str = "Unclaimed"


# =========================================================
# SINGLY LINKED LIST
# =========================================================

class Node:
    def __init__(self, item):
        self.item = item
        self.next = None


class ItemLinkedList:
    def __init__(self):
        self.head = None
        self.tail = None
        self.size = 0

    def append(self, item):
        """Insert at the tail in O(1) time."""
        new_node = Node(item)

        if self.head is None:
            self.head = new_node
        else:
            self.tail.next = new_node

        self.tail = new_node
        self.size += 1

    def sort_by_date(self, newest_first=False):
        """Stable insertion sort by relinking nodes; O(n^2) worst case.

        Uses O(1) extra space. ISO YYYY-MM-DD strings compare by date.
        """
        sorted_head = None
        current = self.head
        while current is not None:
            following = current.next
            previous = None
            position = sorted_head
            while position is not None:
                if newest_first:
                    comes_before = current.item.date_found > position.item.date_found
                else:
                    comes_before = current.item.date_found < position.item.date_found
                if comes_before:
                    break
                previous = position
                position = position.next
            current.next = position
            if previous is None:
                sorted_head = current
            else:
                previous.next = current
            current = following

        self.head = sorted_head
        self.tail = sorted_head
        while self.tail is not None and self.tail.next is not None:
            self.tail = self.tail.next

    def remove_by_id(self, item_id):
        """Find and unlink a node; O(n) worst case."""
        previous = None
        current = self.head
        while current is not None:
            if current.item.item_id == item_id:
                if previous is None:
                    self.head = current.next
                else:
                    previous.next = current.next
                if current is self.tail:
                    self.tail = previous
                self.size -= 1
                return current.item
            previous = current
            current = current.next
        return None

    def find_by_id(self, item_id):
        """Find one record by traversing nodes; O(n) worst case."""
        current = self.head
        while current is not None:
            if current.item.item_id == item_id:
                return current.item
            current = current.next
        return None

    def search(self, keyword):
        """Linear search through every node; O(n) for bounded fields."""
        keyword = keyword.strip().casefold()
        current = self.head
        while current is not None:
            item = current.item
            if (
                keyword in item.name.casefold()
                or keyword in item.category.casefold()
                or keyword in item.location_found.casefold()
            ):
                yield item
            current = current.next

    def __iter__(self):
        """Visit every record from head to tail."""
        current = self.head

        while current is not None:
            yield current.item
            current = current.next


