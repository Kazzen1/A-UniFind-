        self.item_table.bind('<<TreeviewSelect>>', self.selection_changed)
        self.item_table.bind('<Return>', lambda event: self.view_details())
        self.count_text = tk.StringVar()
        ttk.Label(collection, textvariable=self.count_text, style='Muted.TLabel').pack(anchor='w', pady=(10, 0))

        # One-pixel border, without changing the panel's allocated width.
        details_border = tk.Frame(workspace, bg='#dce1ea', width=300)
        details_border.grid(row=0, column=1, sticky='nsew')
        details_border.grid_propagate(False)
        self.details_panel = ttk.Frame(details_border, style='Card.TFrame', width=298)
        self.details_panel.pack(fill='both', expand=True, padx=1, pady=1)
        self.details_panel.grid_propagate(False)
        self.details_panel.columnconfigure(0, weight=1)
        self.details_panel.rowconfigure(1, weight=1)
        ttk.Label(self.details_panel, text='ITEM DETAILS', style='CardMuted.TLabel', padding=(20, 18), font=('Segoe UI', 9, 'bold')).grid(row=0, column=0, sticky='ew')
        scroll_frame = ttk.Frame(self.details_panel, style='Card.TFrame')
        scroll_frame.grid(row=1, column=0, sticky='nsew')
        scroll_frame.rowconfigure(0, weight=1)
        scroll_frame.columnconfigure(0, weight=1)
        self.detail_canvas = tk.Canvas(scroll_frame, background='white', highlightthickness=0, width=280)
        scroll = ttk.Scrollbar(scroll_frame, orient='vertical', command=self.detail_canvas.yview)
        self.detail_canvas.configure(yscrollcommand=scroll.set)
        self.detail_canvas.grid(row=0, column=0, sticky='nsew')
        scroll.grid(row=0, column=1, sticky='ns')
        self.detail_body = ttk.Frame(self.detail_canvas, style='Card.TFrame', padding=(20, 4, 20, 20))
        body_id = self.detail_canvas.create_window((0, 0), window=self.detail_body, anchor='nw')
        self.detail_body.bind('<Configure>', lambda event: self.detail_canvas.configure(scrollregion=self.detail_canvas.bbox('all')))
        self.detail_canvas.bind('<Configure>', lambda event: self.detail_canvas.itemconfigure(body_id, width=event.width))
        self.detail_actions = ttk.Frame(self.details_panel, style='Card.TFrame', padding=(16, 12))
        self.detail_actions.grid(row=2, column=0, sticky='ew')
        self.render_details(None)
        self.status_text = tk.StringVar()
        ttk.Label(main, textvariable=self.status_text, style='Muted.TLabel', wraplength=800).pack(anchor='w', pady=(12, 0))

    def select_section(self, section):
        if not self.staff_user and section != 'Unclaimed':
            return
        self.active_section = section
        self.refresh_table()

    def selection_changed(self, event=None):
        if not self.refreshing:
            self.view_details()

    def select_card(self, item_id):
        row_id = str(item_id)
        if self.item_table.exists(row_id):
            self.item_table.selection_set(row_id)
            self.view_details()
            for card_id, card in self.card_widgets.items():
                card.configure(bg='#9eafd5' if card_id == item_id else '#dce1ea')

    def scroll_cards(self, event):
        if event.delta:
            self.card_canvas.yview_scroll(-1 if event.delta > 0 else 1, 'units')
        return 'break'

    def render_cards(self, items):
        for child in self.card_body.winfo_children():
            child.destroy()
        self.card_widgets = {}
        selected = self.item_table.selection()
        selected_id = int(selected[0]) if selected else None
        for column in range(2):
            self.card_body.columnconfigure(column, weight=1, uniform='card')
        if not items:
            tk.Label(self.card_body, text='No items found', bg='#f6f7fa', fg='#263550',
                     font=('Segoe UI', 15, 'bold')).grid(row=0, column=0, sticky='w', padx=12, pady=(24, 4))
            tk.Label(self.card_body, text='Try a different search or category.', bg='#f6f7fa',
                     fg='#707b8f', font=('Segoe UI', 10)).grid(row=1, column=0, sticky='w', padx=12)
            return
        for index, item in enumerate(items):
            border = tk.Frame(self.card_body, bg='#9eafd5' if item.item_id == selected_id else '#dce1ea')
            border.grid(row=index // 2, column=index % 2, sticky='nsew', padx=7, pady=7)
            self.card_widgets[item.item_id] = border
            card = tk.Frame(border, bg='white', padx=15, pady=14)
            card.pack(fill='both', expand=True, padx=1, pady=1)
            border.bind('<MouseWheel>', self.scroll_cards)
            card.bind('<MouseWheel>', self.scroll_cards)
            labels = (
                (f'RECORD #{item.item_id}', '#707b8f', 8, 'bold'),
                (item.name, '#263550', 13, 'bold'),
                (item.category, '#3b5191', 9, 'bold'),
                (f'Found {date.fromisoformat(item.date_found):%b %d, %Y}', '#58647d', 9, 'normal'),
                (item.location_found, '#58647d', 9, 'normal'),
            )
            for row, (value, color, size, weight) in enumerate(labels):
                label = tk.Label(card, text=value, bg='white', fg=color,
                                 font=('Segoe UI', size, weight), anchor='w', justify='left',
                                 wraplength=170)
                label.pack(fill='x', pady=(0, 8 if row == 1 else 5))
                label.bind('<Button-1>', lambda event, item_id=item.item_id: self.select_card(item_id))
                label.bind('<MouseWheel>', self.scroll_cards)
            for widget in (border, card):
                widget.bind('<Button-1>', lambda event, item_id=item.item_id: self.select_card(item_id))

    def refresh_table(self):
        selected = self.item_table.selection()
        self.refreshing = True
        self.items.sort_by_date(newest_first=self.sort_var.get() == 'Newest first')
        for row in self.item_table.get_children():
            self.item_table.delete(row)
        keyword = self.search_var.get().strip()
        records = self.items.search(keyword) if keyword else self.items
        shown = 0
        visible_items = []
        for item in records:
            if not self.staff_user and item.status != 'Unclaimed':
                continue
            if self.active_section != 'All items' and item.status != self.active_section:
                continue
            if self.category_var.get() != 'All categories' and item.category != self.category_var.get():
                continue
            values = {'item_id': item.item_id, 'name': item.name, 'category': item.category,
                      'date_found': item.date_found, 'status': item.status}
            self.item_table.insert('', 'end', iid=str(item.item_id), values=tuple(values[c] for c in self.table_columns), tags=('alternate',) if shown % 2 else ())
            visible_items.append(item)
            shown += 1
        if selected and self.item_table.exists(selected[0]):
            self.item_table.selection_set(selected[0])
        if not self.staff_user:
            self.render_cards(visible_items)
        unclaimed = sum(item.status == 'Unclaimed' for item in self.items)
        counts = {'All items': self.items.size, 'Unclaimed': unclaimed, 'Claimed': self.items.size-unclaimed}
        for section, button in self.nav_buttons.items():
            button.configure(text=f'{section}  ({counts[section]})', style='NavSelected.TButton' if section==self.active_section else 'Nav.TButton')
        self.section_title.set('Found items' if not self.staff_user else self.active_section)
        self.count_text.set(f'{shown} item(s) shown')
        if not shown:
            self.status_text.set('No items match these filters.')
        elif keyword:
            self.status_text.set(f'Search results for "{keyword}".')
        else:
            self.status_text.set('Select a row to view its details.' if self.staff_user else 'Select a card to view its details.')
        self.refreshing = False
        self.view_details()

    def clear_search(self):
        self.search_var.set('')
        self.category_var.set('All categories')
        self.refresh_table()

    def render_details(self, item):
        for area in (self.detail_body, self.detail_actions):
            for child in area.winfo_children():
                child.destroy()
        self.detail_canvas.yview_moveto(0)
        if item is None:
            ttk.Label(self.detail_body, text='Select an item', style='Card.TLabel', font=('Segoe UI', 16, 'bold')).pack(anchor='w', pady=(18, 8))
            hint = 'Choose a row from the collection to see its information here.' if self.staff_user else 'Choose a card from the collection to see its information here.'
            ttk.Label(self.detail_body, text=hint, style='CardMuted.TLabel', wraplength=235, justify='left').pack(anchor='w')
            return
        ttk.Label(self.detail_body, text=f'RECORD #{item.item_id}', style='CardMuted.TLabel', font=('Segoe UI', 9)).pack(anchor='w', pady=(0, 8))
        ttk.Label(self.detail_body, text=item.name, style='Card.TLabel', font=('Segoe UI', 18, 'bold'), wraplength=235, justify='left').pack(anchor='w', pady=(0, 12))
        tk.Label(self.detail_body, text=item.status, background='#e9edf7' if item.status=='Unclaimed' else '#edf0f2', foreground='#344d83' if item.status=='Unclaimed' else '#505e6e', font=('Segoe UI', 9, 'bold'), padx=10, pady=5).pack(anchor='w', pady=(0, 22))
        # Separate the item's identity/status from its details.
        tk.Frame(self.detail_body, bg='#dce1ea', height=1).pack(fill='x', pady=(0, 20))
        fields = [('Category', item.category), ('Date found', date.fromisoformat(item.date_found).strftime('%B %d, %Y')), ('Location found', item.location_found)]
        if self.staff_user:
            fields += [('Kept at - Staff only', item.storage_location), ('Private description', item.description or 'No description provided.')]
        else:
            fields += [('How to inquire', 'Speak with the staff member operating A-UniFind and quote this record number. Bring identifying details to help verify ownership.')]
        for label, value in fields:
            ttk.Label(self.detail_body, text=label.upper(), style='CardMuted.TLabel', font=('Segoe UI', 8, 'bold')).pack(anchor='w', pady=(0, 5))
            ttk.Label(self.detail_body, text=value, style='Card.TLabel', wraplength=235, justify='left').pack(anchor='w', pady=(0, 18))
        if self.staff_user:
            # Separate record details from destructive/claim actions.
            tk.Frame(self.detail_actions, bg='#dce1ea', height=1).pack(fill='x', pady=(0, 14))
            ttk.Button(self.detail_actions, text='Edit Item', command=self.open_edit_form).pack(fill='x', pady=(0, 6))
            claim = ttk.Button(self.detail_actions, text='Mark as Claimed', style='Primary.TButton', command=self.mark_as_claimed)
            claim.pack(fill='x', pady=(0, 6))
            if item.status == 'Claimed':
                claim.state(['disabled'])
            ttk.Button(self.detail_actions, text='Delete Record', style='Danger.TButton', command=self.delete_record).pack(fill='x')

    def delete_record(self):
        if not self.require_staff():
            return
        selected = self.item_table.selection()
        if not selected:
            messagebox.showinfo(
                "Select an Item", "Select an item in the table first.",
                parent=self.root,
            )
            return
        item = self.items.find_by_id(int(selected[0]))
        if item is None:
            messagebox.showerror(
                "Item Not Found", "This record is no longer available.",
                parent=self.root,
            )
            self.refresh_table()
            return
        if not messagebox.askyesno(
            "Delete Record?",
            f'Permanently delete item #{item.item_id}: {item.name}?\n\n'
            "This removes the saved record and cannot be undone.\n"
            "For a returned item, use Mark as Claimed to keep its history.",
            icon="warning", default="no", parent=self.root,
        ):
            return
        try:
            # Save the remaining records before unlinking anything in memory.
            save_records(self.items, self.next_id, exclude_id=item.item_id)
        except OSError as error:
            messagebox.showerror(
                "Could Not Save",
                "The record was not deleted because saving failed.\n\n"
                f"Details: {error}", parent=self.root,
            )
            return
        self.items.remove_by_id(item.item_id)
        self.refresh_table()
        self.status_text.set(f"Deleted item #{item.item_id} and saved the change.")

    def mark_as_claimed(self):
        if not self.require_staff():
            return
        selected = self.item_table.selection()
        if not selected:
            messagebox.showinfo(
                "Select an Item", "Select an item in the table first.",
                parent=self.root,
            )
            return

        item = self.items.find_by_id(int(selected[0]))
        if item is None:
            messagebox.showerror(
                "Item Not Found", "This record is no longer available.",
                parent=self.root,
            )
            self.refresh_table()
            return
        if item.status == "Claimed":
            messagebox.showinfo(
                "Already Claimed", "This item has already been marked as claimed.",
                parent=self.root,
            )
            return

        confirmed = messagebox.askyesno(
            "Confirm Item Return",
            f'Item #{item.item_id}: {item.name}\n\n'
            "Have you verified ownership and returned this item to its owner?\n\n"
            "Choose Yes to mark it as claimed and save the change.",
            parent=self.root,
        )
        if not confirmed:
            return

        previous_status = item.status
        item.status = "Claimed"
        try:
            save_records(self.items, self.next_id)
        except OSError as error:
            # Restore memory too, so the display and saved file still agree.
            item.status = previous_status
            messagebox.showerror(
                "Could Not Save",
                "The claim was not saved. The item's status is unchanged.\n\n"
                f"Details: {error}",
                parent=self.root,
            )
            return

        self.refresh_table()
        row_id = str(item.item_id)
        if self.item_table.exists(row_id):
            self.item_table.selection_set(row_id)
            self.item_table.see(row_id)
        self.status_text.set(
            f"Item #{item.item_id} marked as claimed and saved."
        )

    def view_details(self):
        selected = self.item_table.selection()
        item = self.items.find_by_id(int(selected[0])) if selected else None
        if item is not None and not self.staff_user and item.status != "Unclaimed":
            item = None
        self.render_details(item)

    def open_add_form(self):
        self.open_item_form()

    def open_edit_form(self):
        if not self.require_staff():
            return
        selected = self.item_table.selection()
        if not selected:
            messagebox.showinfo("Select an Item", "Select an item in the table first.", parent=self.root)
            return
        item = self.items.find_by_id(int(selected[0]))
        if item is None:
            messagebox.showerror("Item Not Found", "This record is no longer available.", parent=self.root)
            self.refresh_table()
            return
        self.open_item_form(item)

    def open_item_form(self, existing=None):
        if not self.require_staff():
            return
        if self.add_window is not None:
            self.add_window.lift()
            return

        window = tk.Toplevel(self.root)
        self.add_window = window

        window.title(f"Edit Item #{existing.item_id} | A-UniFind" if existing else "Add Found Item | A-UniFind")
        window.resizable(False, False)
        window.transient(self.root)

        form = ttk.Frame(window, padding=20)
        form.pack(fill="both", expand=True)
        form.columnconfigure(1, weight=1)

        ttk.Label(
            form,
            text=f"Edit Item #{existing.item_id}" if existing else "Register a Found Item",
            font=("Segoe UI", 15, "bold"),
        ).grid(
            row=0, column=0, columnspan=2,
            sticky="w", pady=(0, 5)
        )

        ttk.Label(
            form,
            text="Fields marked * are required. ID and status stay unchanged." if existing else "Fields marked * are required.",
        ).grid(
            row=1, column=0, columnspan=2,
            sticky="w", pady=(0, 15)
        )

        name_var = tk.StringVar(value=existing.name if existing else "")
        category_var = tk.StringVar(value=existing.category if existing else "")
        location_var = tk.StringVar(value=existing.location_found if existing else "")
        date_var = tk.StringVar(value=existing.date_found if existing else date.today().isoformat())
        storage_var = tk.StringVar(value=existing.storage_location if existing else "")

        def add_entry(row, label, variable):
            ttk.Label(form, text=label).grid(
                row=row, column=0, sticky="w",
                padx=(0, 15), pady=7
            )

            entry = ttk.Entry(
                form, textvariable=variable, width=38
            )
            entry.grid(row=row, column=1, sticky="ew", pady=7)
            return entry

        name_entry = add_entry(2, "Item name *", name_var)

        ttk.Label(form, text="Category *").grid(
            row=3, column=0, sticky="w",
            padx=(0, 15), pady=7
        )

        ttk.Combobox(
            form,
            textvariable=category_var,
            values=CATEGORIES,
            state="readonly",
            width=35,
        ).grid(row=3, column=1, sticky="ew", pady=7)

        add_entry(4, "Location found *", location_var)
        add_entry(5, "Date found (YYYY-MM-DD) *", date_var)
        add_entry(6, "Storage location *", storage_var)

        ttk.Label(form, text="Private description").grid(
            row=7, column=0, sticky="nw",
            padx=(0, 15), pady=7
        )

        description_box = tk.Text(
            form, width=38, height=4, wrap="word"
        )
        description_box.grid(
            row=7, column=1, sticky="ew", pady=7
        )
        if existing:
            description_box.insert("1.0", existing.description)

        def close_form():
            window.grab_release()
            self.add_window = None
            window.destroy()

        def submit_item():
            if not self.require_staff():
                return
            name = name_var.get().strip()
            category = category_var.get().strip()
            location = location_var.get().strip()
            date_text = date_var.get().strip()
            storage = storage_var.get().strip()
            description = description_box.get(
                "1.0", "end-1c"
            ).strip()

            if not all((name, category, location, date_text, storage)):
                messagebox.showerror(
                    "Missing Information",
                    "Please complete every required field.",
                    parent=window,
                )
                return

            try:
                found_date = date.fromisoformat(date_text)

                if found_date.isoformat() != date_text:
                    raise ValueError

            except ValueError:
                messagebox.showerror(
                    "Invalid Date",
                    "Enter a valid date in YYYY-MM-DD format.\n"
                    "Example: 2026-11-12",
                    parent=window,
                )
                return

            if found_date > date.today():
                messagebox.showerror(
                    "Invalid Date",
                    "The date found cannot be in the future.",
                    parent=window,
                )
                return

            item = FoundItem(
                item_id=existing.item_id if existing else self.next_id,
                name=name,
                category=category,
                description=description,
                location_found=location,
                date_found=found_date.isoformat(),
                storage_location=storage,
                status=existing.status if existing else "Unclaimed",
            )

            # Save first. Keep the form open if saving fails.
            try:
                if existing:
                    save_records(self.items, self.next_id, replacement=item)
                else:
                    save_records(self.items, next_id=self.next_id + 1, new_item=item)
            except OSError as error:
                messagebox.showerror(
                    "Could Not Save",
                    "The changes were not applied because saving failed.\n"
                    "Your form entries have been kept. Check that the "
                    "project folder is writable and try again.\n\n"
                    f"Details: {error}",
                    parent=window,
                )
                return

            if existing:
                # Commit to the same linked-list record only after saving succeeds.
                for field, value in asdict(item).items():
                    setattr(existing, field, value)
            else:
                self.items.append(item)
                self.next_id += 1
            self.active_section = "All items"
            self.clear_search()

            row_id = str(item.item_id)
            self.item_table.selection_set(row_id)
            self.item_table.see(row_id)
            self.view_details()

            self.status_text.set(
                f'{"Updated" if existing else "Added"} and saved item #{item.item_id}: "{item.name}".'
            )

            close_form()

        buttons = ttk.Frame(form)
        buttons.grid(
            row=8, column=0, columnspan=2,
            sticky="e", pady=(15, 0)
        )

        ttk.Button(
            buttons, text="Cancel", command=close_form
        ).pack(side="left", padx=(0, 8))

        ttk.Button(
            buttons, text="Save Changes" if existing else "Add Item", command=submit_item
        ).pack(side="left")

        window.protocol("WM_DELETE_WINDOW", close_form)
        window.bind("<Escape>", lambda event: close_form())
        window.grab_set()
        name_entry.focus_set()


def run_app():
    root = tk.Tk()
    root.withdraw()

    try:
        items, next_id = load_records()
    except (OSError, ValueError) as error:
        messagebox.showerror(
            "Could Not Load Records",
            "The saved records could not be loaded.\n"
            "The app will close to avoid overwriting them.\n"
            "Keep the file and report this error for troubleshooting.\n\n"
            f"File: {DATA_FILE}\n\n"
            f"Details: {error}",
            parent=root,
        )
        root.destroy()
        return

    try:
        app = LostAndFoundApp(root, items, next_id)
    except (sqlite3.Error, OSError) as error:
        messagebox.showerror("Account File Error", f"Could not open staff account storage.\n\n{error}", parent=root)
        root.destroy()
        return
    root.deiconify()
    root.mainloop()


def main():
    lock = SingleInstanceLock(DATA_FILE.with_suffix(".lock"))
    try:
        acquired = lock.acquire()
    except OSError as error:
        root = tk.Tk()
        root.withdraw()
        messagebox.showerror(
            "Could Not Start",
            f"Could not protect the records file. A-UniFind will close.\n\n{error}",
            parent=root,
        )
        root.destroy()
        return
    if not acquired:
        root = tk.Tk()
        root.withdraw()
        messagebox.showinfo(
            "A-UniFind Is Already Open",
            "Another copy is already using these records.\n"
            "Use the existing window, or close it before opening another copy.",
            parent=root,
        )
        root.destroy()
        return
    try:
        run_app()
    finally:
        lock.release()


if __name__ == "__main__":
    main()
