def load_records():
    """Read JSON and rebuild the linked list."""
    items = ItemLinkedList()

    if not DATA_FILE.exists():
        return items, 1

    with DATA_FILE.open("r", encoding="utf-8") as file:
        saved_data = json.load(file)

    if not isinstance(saved_data, dict):
        raise ValueError("The saved file must contain a JSON object.")

    if saved_data.get("version") != 1:
        raise ValueError("The saved file version is not supported.")

    records = saved_data.get("items")
    next_id = saved_data.get("next_id")

    if not isinstance(records, list):
        raise ValueError("The saved item collection is invalid.")

    if type(next_id) is not int or next_id < 1:
        raise ValueError("The saved next ID is invalid.")

    seen_ids = set()
    highest_id = 0

    for record in records:
        if not isinstance(record, dict):
            raise ValueError("A saved record is not a JSON object.")

        try:
            item = FoundItem(**record)
        except TypeError as error:
            raise ValueError("A saved record has invalid fields.") from error

        if type(item.item_id) is not int or item.item_id < 1:
            raise ValueError("A saved item has an invalid ID.")

        if item.item_id in seen_ids:
            raise ValueError("The saved file contains duplicate IDs.")

        required_text = (
            item.name,
            item.category,
            item.location_found,
            item.date_found,
            item.storage_location,
        )

        if not all(
            isinstance(value, str) and value.strip()
            for value in required_text
        ):
            raise ValueError("A saved item is missing required information.")

        if not isinstance(item.description, str):
            raise ValueError("A saved description is invalid.")

        if item.category not in CATEGORIES:
            raise ValueError("A saved category is invalid.")

        if item.status not in ("Unclaimed", "Claimed"):
            raise ValueError("A saved status is invalid.")

        parsed_date = date.fromisoformat(item.date_found)

        if parsed_date.isoformat() != item.date_found:
            raise ValueError("A saved date must use YYYY-MM-DD format.")

        seen_ids.add(item.item_id)
        highest_id = max(highest_id, item.item_id)
        items.append(item)

    if next_id <= highest_id:
        raise ValueError("The saved next ID conflicts with existing records.")

    return items, next_id


def save_records(items, next_id, new_item=None, exclude_id=None, replacement=None):
    """Save a snapshot before committing a new item to memory."""
    records = [
        asdict(replacement if replacement is not None and item.item_id == replacement.item_id else item)
        for item in items if item.item_id != exclude_id
    ]

    if new_item is not None:
        records.append(asdict(new_item))

    saved_data = {
        "version": 1,
        "next_id": next_id,
        "items": records,
    }

    temporary_file = DATA_FILE.with_suffix(".json.tmp")

    try:
        # Write a complete temporary file before replacing the old file.
        with temporary_file.open("w", encoding="utf-8") as file:
            json.dump(saved_data, file, indent=2, ensure_ascii=False)
            file.flush()
            os.fsync(file.fileno())

        os.replace(temporary_file, DATA_FILE)

    finally:
        # Clean up an incomplete temporary file if saving failed.
        try:
            temporary_file.unlink(missing_ok=True)
        except OSError:
            pass


