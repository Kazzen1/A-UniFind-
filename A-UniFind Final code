class SingleInstanceLock:
    """Windows byte-range lock shared by copies using the same records file.

    Keep the lock file: deleting it could let another process lock a different
    file. Windows releases the held byte automatically if the process exits.
    """
    def __init__(self, path):
        self.path = path
        self.handle = None

    def acquire(self):
        handle = self.path.open("a+b")
        try:
            handle.seek(0, os.SEEK_END)
            if handle.tell() == 0:
                handle.write(b"\0")
                handle.flush()
            handle.seek(0)
            try:
                msvcrt.locking(handle.fileno(), msvcrt.LK_NBLCK, 1)
            except OSError as error:
                if error.errno in (errno.EACCES, errno.EAGAIN, errno.EDEADLK):
                    handle.close()
                    return False
                raise
            self.handle = handle
            return True
        except BaseException:
            handle.close()
            raise

    def release(self):
        if self.handle is not None:
            try:
                self.handle.seek(0)
                msvcrt.locking(self.handle.fileno(), msvcrt.LK_UNLCK, 1)
            finally:
                self.handle.close()
                self.handle = None


class StaffAccounts:
    """Local credentials using salted PBKDF2 hashes, never plaintext passwords."""
    def __init__(self, path):
        self.path = path
        with closing(sqlite3.connect(path)) as connection, connection:
            connection.execute(
                "CREATE TABLE IF NOT EXISTS staff (username TEXT PRIMARY KEY, "
                "salt BLOB NOT NULL, digest BLOB NOT NULL, iterations INTEGER NOT NULL)"
            )

    def has_accounts(self):
        with closing(sqlite3.connect(self.path)) as connection, connection:
            return connection.execute("SELECT 1 FROM staff LIMIT 1").fetchone() is not None

    def create_first(self, username, password):
        username = " ".join(username.split())
        if not 3 <= len(username) <= 40 or not all(ch.isalpha() or ch == " " for ch in username):
            raise ValueError("Staff name must be 3–40 letters and spaces; numbers and symbols are not allowed.")
        if not 8 <= len(password) <= 30:
            raise ValueError("Password must contain 8–30 characters.")
        salt = os.urandom(16)
        iterations = 600000
        digest = hashlib.pbkdf2_hmac("sha256", password.encode(), salt, iterations)
        with closing(sqlite3.connect(self.path)) as connection, connection:
            connection.execute("BEGIN IMMEDIATE")
            if connection.execute("SELECT 1 FROM staff LIMIT 1").fetchone():
                raise ValueError("Staff setup is already complete. Please sign in.")
            connection.execute("INSERT INTO staff VALUES (?, ?, ?, ?)",
                               (username, salt, digest, iterations))

    def verify(self, username, password):
        # Keep existing credentials valid if created under the previous limit.
        if len(password) > 128:
            return False
        with closing(sqlite3.connect(self.path)) as connection, connection:
            row = connection.execute(
                "SELECT salt, digest, iterations FROM staff WHERE username = ?",
                (" ".join(username.split()),),
            ).fetchone()
        salt, expected, iterations = row if row else (b"\0" * 16, b"\0" * 32, 600000)
        actual = hashlib.pbkdf2_hmac("sha256", password.encode(), salt, iterations)
        return row is not None and hmac.compare_digest(actual, expected)

