    def clear_filter_focus_on_background(self, event):
        # Tkinter leaves a combobox focused when a plain frame or label is clicked.
        if (isinstance(self.root.focus_get(), ttk.Combobox)
                and event.widget.winfo_class() in ('TFrame', 'Frame', 'TLabel', 'Label', 'Canvas')):
            self.root.after_idle(self.root.focus_set)

    def clear_screen(self):
        # Close private dialogs too when leaving staff mode.
        for child in self.root.winfo_children():
            child.destroy()
        self.add_window = None

    def show_home(self):
        self.staff_user = None
        self.clear_screen()
        frame = ttk.Frame(self.root, padding=40)
        frame.place(relx=0.5, rely=0.45, anchor="center")
        if self.logo_image is not None:
            ttk.Label(frame, image=self.logo_image).pack(anchor="center", pady=(0, 10))
        else:
            ttk.Label(frame, text="A-UniFind", font=("Segoe UI", 36, "bold")).pack(anchor="w")
        ttk.Label(frame, text="Lost something? Start here.", font=("Segoe UI", 18)).pack(anchor="w", pady=(8, 20))
        ttk.Label(frame, text="Browse found belongings, then speak with staff to verify ownership.\nItem returns are handled in person.").pack(anchor="w", pady=(0, 24))
        ttk.Button(frame, text="Browse Items", style="Primary.TButton", command=self.open_browse).pack(fill="x", pady=5)
        ttk.Button(frame, text="Staff Login", command=self.open_login).pack(fill="x", pady=5)
        ttk.Label(frame, text="Campus Lost and Found Management System").pack(pady=(24, 0))

    def open_browse(self):
        self.staff_user = None
        self.clear_screen()
        self.build_interface()
        self.refresh_table()

    def require_staff(self):
        if self.staff_user is not None:
            return True
        messagebox.showwarning("Staff Access Required", "Sign in as staff to manage records.", parent=self.root)
        return False

    def open_login(self):
        try:
            setup = not self.accounts.has_accounts()
        except sqlite3.Error as error:
            messagebox.showerror("Account File Error", str(error), parent=self.root)
            return
        self.clear_screen()
        frame = ttk.Frame(self.root, padding=30)
        frame.place(relx=0.5, rely=0.45, anchor="center")
        ttk.Label(frame, text="Set up staff access" if setup else "Staff sign in", font=("Segoe UI", 24, "bold")).pack(anchor="w", pady=(0, 12))
        ttk.Label(frame, text="First use: the responsible operator creates the staff account." if setup else "Manage found items and record their return.", wraplength=420).pack(anchor="w", pady=(0, 16))
        variables = {}
        fields = ["Staff name", "Password"] + (["Confirm password"] if setup else [])
        if setup:
            ttk.Label(frame, text="Staff name: letters and spaces only (3–40 characters).", wraplength=420).pack(anchor="w")
            ttk.Label(frame, text="Password: 8–30 characters. Spaces and symbols are allowed.", wraplength=420).pack(anchor="w")
        for label in fields:
            ttk.Label(frame, text=label).pack(anchor="w", pady=(8, 4))
            variables[label] = tk.StringVar()
            entry = ttk.Entry(frame, textvariable=variables[label], show="" if label == "Staff name" else "*", width=40)
            if setup and label == "Staff name":
                # Reject invalid typing and pasted text before it reaches the field.
                entry.configure(
                    validate="key",
                    validatecommand=(entry.register(
                        lambda proposed: len(proposed) <= 40
                        and all(char.isalpha() or char == " " for char in proposed)
                    ), "%P"),
                )
            entry.pack(fill="x")
        feedback = tk.StringVar()
        ttk.Label(frame, textvariable=feedback, wraplength=420, foreground="#a12626").pack(pady=12)

        def submit():
            username = variables["Staff name"].get().strip()
            password = variables["Password"].get()
            try:
                if setup:
                    if password != variables["Confirm password"].get():
                        raise ValueError("Passwords do not match.")
                    self.accounts.create_first(username, password)
                elif not self.accounts.verify(username, password):
                    raise ValueError("Incorrect staff name or password.")
            except (ValueError, sqlite3.Error) as error:
                feedback.set(str(error))
                variables["Password"].set("")
                if setup:
                    variables["Confirm password"].set("")
                return
            self.staff_user = " ".join(username.split())
            for variable in variables.values():
                variable.set("")
            self.clear_screen()
            self.build_interface()
            self.refresh_table()

        ttk.Button(frame, text="Create staff account" if setup else "Sign in", style="Primary.TButton", command=submit).pack(fill="x", pady=5)
        ttk.Button(frame, text="Back", command=self.show_home).pack(fill="x", pady=5)

